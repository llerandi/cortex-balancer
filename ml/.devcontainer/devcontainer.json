{
    "name": "Cortex Balancer ML (Python 3.12)",
    "image": "mcr.microsoft.com/devcontainers/python:0-3.12-bullseye",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
